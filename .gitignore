# IDE / OS
.idea
.DS_Store
*.iml
.vscode/*
!.vscode/extensions.json

# Claude Code local/session artifacts (settings.json, agents/, skills/, commands/ ARE committed)
.claude/settings.local.json
.claude/tmp/
.claude/worktrees/
CLAUDE.local.md

# Rust
target/
**/*.rs.bk

# Node / TypeScript (anchored to known output locations)
node_modules/
clients/vscode/dist/
clients/vscode/out/
clients/vscode/coverage/
apps/desktop/dist/
apps/desktop/coverage/
apps/desktop/.vite/
*.tsbuildinfo

# Java / Gradle / Kotlin
.gradle/
clients/jetbrains/build/
clients/jetbrains/.intellijPlatform/

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/

# Environment / secrets — never commit
.env
.env.*
*.pem
*.key

# Local tool/session artifacts (not project work)
.mimosa/
.v2c/
.video_agent/
.zcodeignore
clients/vscode/*.vsix
